{
  "name": "verify-exe-test",
  "version": "0.1.0",
  "private": true,
  "description": "人机验证页面 → 单文件 EXE 打包测试（源码加密 + 禁用右键/开发者工具）",
  "author": "pythonWsr",
  "main": "electron/main.js",
  "scripts": {
    "encrypt": "node scripts/encrypt.js",
    "dist": "node scripts/encrypt.js && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.parkerstudio.verifytest",
    "productName": "VerifyDemo",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VerifyDemo-${version}.exe"
    },
    "portable": {
      "unicode": true
    }
  }
}
